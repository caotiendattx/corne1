#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp TAB         &kp Q  &kp W  &kp E         &kp R  &kp T        &kp Y    &kp U  &kp I              &kp O    &kp P     &kp BSPC
&kp LEFT_SHIFT  &kp A  &kp S  &kp D         &kp F  &kp G        &kp H    &kp J  &kp K              &kp L    &kp SEMI  &kp SQT
&kp LCTRL       &kp Z  &kp X  &kp C         &kp V  &kp B        &kp N    &kp M  &kp COMMA          &kp DOT  &kp FSLH  &kp RIGHT_SHIFT
                              &kp LEFT_ALT  &mo 1  &kp SPACE    &kp RET  &mo 2  &kp RIGHT_COMMAND
            >;
        };

        lower_layer {
            display-name = "Lower Layer";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp ESCAPE  &kp N1           &kp N2       &kp N3          &kp N4      &kp N5         &kp N6     &kp N7            &kp N8             &kp N9                &kp N0                 &kp BACKSPACE
&kp GRAVE   &kp EXCLAMATION  &kp AT_SIGN  &kp HASH        &kp DOLLAR  &kp PERCENT    &kp CARET  &kp AMPERSAND     &kp ASTERISK       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp NON_US_BACKSLASH
&kp TILDE   &kp UNDERSCORE   &kp MINUS    &kp EQUAL       &kp PLUS    &kp SLASH      &kp COMMA  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp PIPE
                                          &kp LEFT_SHIFT  &trans      &kp SPACE      &kp RET    &kp PERIOD        &kp MINUS
            >;
        };

        raise_layer {
            display-name = "Raise Layer";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp ESC    &kp F1      &kp F2        &kp F3            &kp F4        &kp F5       &kp C_VOL_UP       &kp C_MUTE      &kp UP_ARROW      &kp PRINTSCREEN  &kp C_BRIGHTNESS_INC  &kp DEL
&kp TAB    &kp F6      &kp F7        &kp F8            &kp F9        &kp F10      &kp C_VOLUME_DOWN  &kp LEFT        &kp DOWN          &kp RIGHT        &kp C_BRIGHTNESS_DEC  &kp PAGE_UP
&kp LSHFT  &bt BT_CLR  &bt BT_SEL 1  &bt BT_SEL 2      &kp F11       &kp F12      &bt BT_CLR_ALL     &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_NEXT       &trans                &kp PAGE_DOWN
                                     &kp LEFT_CONTROL  &kp LEFT_ALT  &kp SPACE    &kp RET            &trans          &kp RIGHT_WIN
            >;
        };
    };
};
